{
  "name": "payload-backend-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "payload generate:importmap && next build",
    "start": "next start --port 3001",
    "generate:importmap": "payload generate:importmap",
    "e2e:serve": "payload generate:importmap && next dev --port 3001"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "next": "^16.3.8",
    "payload": "3.90.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": false,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  },
  "overrides": {
    "dompurify": "3.4.13",
    "esbuild": "^0.25.0",
    "payload": {
      "undici": "7.29.1"
    },
    "@payloadcms/next": {
      "sass": "1.79.6"
    }
