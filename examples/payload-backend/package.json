{
  "name": "payload-backend-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "payload generate:importmap && next build",
    "start": "next start --port 3001",
    "generate:importmap": "payload generate:importmap",
    "e2e:serve": "payload generate:importmap && next dev --port 3001"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "next": "^16.3.0",
    "payload": "3.88.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  },
  "overrides": {
    "dompurify": "3.4.13"
  }
}
