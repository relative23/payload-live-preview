---
/**
 * Reveal-edited-field browser fixture. `heroTitle` is at the top; `footer` sits
 * below a viewport-plus spacer, off-screen on load. Framed by
 * `/bench?target=/reveal/`; reveal.spec.ts edits `footer` and asserts the
 * preview scrolled it into view.
 */
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Reveal fixture</title>
    <style>
      body { margin: 0; font: 16px/1.5 system-ui, sans-serif; }
      .spacer { height: 2200px; }
    </style>
  </head>
  <body>
    <h1 data-payload-field="heroTitle" data-payload-owner="global:reveal" data-testid="hero">Top</h1>
    <div class="spacer">scroll down for the footer</div>
    <p data-payload-field="footer" data-payload-owner="global:reveal" data-testid="footer">old footer</p>
  </body>
</html>
