---
// Mock admin: frames a route from its allowlist with a preview token, the
// way a real Payload admin frames the URL its `livePreview.url` callback
// returns. Without the token the framed page is a public response: the hook
// refuses it and the middleware injects nothing.
import { issuePreviewToken } from 'payload-live-preview';
import { PREVIEW_AUDIENCE, PREVIEW_TOKEN_SECRET } from '../live-preview/settings';

const ROUTES = ['/', '/reveal'];
const requested = Astro.url.searchParams.get('target');
const target = ROUTES.find((route) => route === requested) ?? ROUTES[0];
const token = await issuePreviewToken(
  { audience: PREVIEW_AUDIENCE, path: target, ttlMs: 10 * 60_000 },
  { secret: PREVIEW_TOKEN_SECRET },
);
const src = `${target}?preview=true&previewToken=${encodeURIComponent(token)}`;
---
<html lang="en">
  <head><meta charset="utf-8" /><title>Mock admin</title></head>
  <body style="margin:0">
    <iframe id="preview" data-testid="preview-frame" title="Live preview" src={src}
            style="width:100%;height:600px;border:0"></iframe>
  </body>
</html>
