import {
  LivePreviewClient,
  authorizePreviewRequest,
  bind,
  generateInlineScript,
  type FieldRenderer,
  type LivePreviewPlugin,
} from 'payload-live-preview';
import { EventEmitter, initLivePreview } from 'payload-live-preview/core';
import {
  createFragmentEndpoint,
  createLivePreviewMiddleware as createAstroMiddleware,
  hasPreviewIntent,
  livePreview,
  type LivePreviewAstroOptions,
  type LivePreviewLocals,
} from 'payload-live-preview/astro';
import { onRequest } from 'payload-live-preview/astro/middleware-entry';
import {
  createLivePreviewMiddleware as createNextMiddleware,
  type LivePreviewNextOptions,
} from 'payload-live-preview/nextjs';
import {
  buildLivePreviewCsp,
  createFragmentEndpoint as createNuxtFragmentEndpoint,
  livePreviewNitroPlugin,
  type LivePreviewLocals as NuxtLivePreviewLocals,
  type LivePreviewNuxtOptions,
} from 'payload-live-preview/nuxt';
import { buildLivePreviewUrl } from 'payload-live-preview/payload';
import {
  livePreview as payloadLivePreview,
  type LivePreviewPluginOptions,
} from 'payload-live-preview/plugin';
import {
  definePreview,
  type AuthorizedPreviewContext,
  type PreviewAuthorizationOutcome,
} from 'payload-live-preview/server';
import {
  createFragmentEndpoint as createSvelteFragmentEndpoint,
  livePreviewHandle,
  type LivePreviewLocals as SvelteKitLivePreviewLocals,
  type LivePreviewSvelteKitOptions,
} from 'payload-live-preview/sveltekit';

const client = new LivePreviewClient({
  allowedOrigins: ['https://admin.example.com'],
  autoStart: false,
  validateToken: async (_token, _origin) => true,
});
const unsubscribe = client.events.on('afterUpdate', ({ data, revision, updatedCount }) => {
  void [data, revision, updatedCount];
});

const synchronousExpressionPlugin: LivePreviewPlugin = {
  name: 'synchronous-expression',
  init: (context) => context.registerTransform('title', (value) => value),
};
const asynchronousExpressionPlugin: LivePreviewPlugin = {
  name: 'asynchronous-expression',
  init: async (context) => context.registerFieldRenderer({ name: 'text', render: () => undefined }),
};
const valueReturningRenderer: FieldRenderer = {
  name: 'text',
  render: (target) => target.element.toggleAttribute('data-rendered'),
};

const astroOptions = {
  mode: 'middleware',
  inject: 'preview-only',
} satisfies LivePreviewAstroOptions;
const nextOptions = { inject: 'always' } satisfies LivePreviewNextOptions;
const svelteOptions = { manageCsp: 'full' } satisfies LivePreviewSvelteKitOptions;
const nuxtOptions = { previewSignals: ['query'] } satisfies LivePreviewNuxtOptions;
const payloadOptions = {
  baseUrl: 'https://example.com',
  collections: { posts: ({ data }) => `/posts/${String(data['slug'])}` },
  globals: { homepage: '/' },
  breakpoints: [{ name: 'fluid', label: 'Fluid', width: '100%', height: 900 }],
} satisfies LivePreviewPluginOptions;

const publicValues = [
  generateInlineScript(),
  bind<{ title: string }>('title'),
  new EventEmitter(),
  initLivePreview,
  livePreview(astroOptions),
  createAstroMiddleware(astroOptions),
  createNextMiddleware(nextOptions),
  livePreviewHandle(svelteOptions),
  livePreviewNitroPlugin(nuxtOptions),
  buildLivePreviewCsp(nuxtOptions, 'nonce'),
  buildLivePreviewUrl({ baseUrl: 'https://example.com' }),
  payloadLivePreview(payloadOptions),
  onRequest,
  synchronousExpressionPlugin,
  asynchronousExpressionPlugin,
  valueReturningRenderer,
] as const;

unsubscribe();
void publicValues;

// The documented authorization flow crosses entry boundaries twice: the root
// barrel produces the context, an adapter hook consumes it, and the server
// entry's draft read consumes it again. Each published entry carries its own
// declaration file, so a nominal type that is declared per file — a
// `unique symbol` brand, say — makes these three entries mutually
// incompatible while every entry type-checks perfectly on its own.
const crossEntryOptions: LivePreviewNextOptions = {
  authorizePreview: (request) =>
    authorizePreviewRequest(request, {
      type: 'verifier',
      verify: () => ({ subject: 'editor' }),
    }),
};

async function crossEntryDraftRead(request: Request): Promise<unknown> {
  const document = {
    kind: 'collection',
    slug: 'pages',
    id: 0,
  } as const satisfies import('payload-live-preview/server').AuthorizedPreviewDocument;
  const payload = {
    serverURL: 'https://admin.example.test',
    document,
    maxDepth: 1,
  } satisfies import('payload-live-preview/core').AuthorizedPreviewPayloadScope;
  const scope: import('payload-live-preview').AuthorizedPreviewScope = { payload };
  const verdict = await authorizePreviewRequest(request, {
    type: 'verifier',
    verify: () => ({ subject: 'editor', expiresAt: Date.now() + 60_000, scope }),
  });
  if (!verdict.authorized) return null;
  const preview = definePreview({ serverURL: 'https://admin.example.test', depth: 1 });
  return preview.fetchDocument({ collection: 'pages', id: 0, authorization: verdict.context });
}

// The fragment endpoint takes the middleware's hook as it is, and the intent
// detector the adapters' spelling of the admin origins.
const fragmentEndpoint = createFragmentEndpoint({
  registry: {},
  limits: { timeoutMs: 5000, totalTimeoutMs: 6000 },
  render: (_component, _props, input) => {
    const signal: AbortSignal = input.signal;
    signal.throwIfAborted();
    return Promise.resolve('<p>rendered</p>');
  },
  authorizePreview: (request) =>
    authorizePreviewRequest(request, { type: 'verifier', verify: () => null }),
});

const nativeFragmentOptions = {
  registry: {},
  authorizePreview: () => null,
};
const nuxtFragmentEndpoint = createNuxtFragmentEndpoint(nativeFragmentOptions);
void nuxtFragmentEndpoint(new Request('https://site.example/fragment'));
void nuxtFragmentEndpoint(new Request('https://site.example/fragment'), { node: { req: {} } });
const svelteFragmentEndpoint = createSvelteFragmentEndpoint(nativeFragmentOptions);
void svelteFragmentEndpoint({ request: new Request('https://site.example/fragment') });
void svelteFragmentEndpoint({
  request: new Request('https://site.example/fragment'),
  platform: { req: {} },
});
const intent = hasPreviewIntent(new Request('https://example.com/?preview=true'), {
  allowedOrigins: ['https://admin.example.com'],
});

// Astro's `src/env.d.ts` and SvelteKit's `src/app.d.ts` both augment the
// global `App.Locals`; the three adapter entries export one interface for it.
declare global {
  namespace App {
    interface Locals extends LivePreviewLocals {}
  }
}
// Astro: `Astro.locals` in a page, `context.locals` in middleware.
function astroPage(Astro: { readonly locals: App.Locals }): string | undefined {
  return Astro.locals.livePreviewNonce;
}
// SvelteKit: `event.locals` in a server `load`.
function svelteKitLoad(event: {
  readonly locals: App.Locals & SvelteKitLivePreviewLocals;
}): AuthorizedPreviewContext | undefined {
  return event.locals.livePreviewAuthorization;
}
// Nuxt: `event.context` in a server route.
function nuxtRoute(event: {
  readonly context: NuxtLivePreviewLocals;
}): PreviewAuthorizationOutcome | undefined {
  return event.context.livePreviewAuthorizationOutcome;
}

export {
  astroPage,
  crossEntryDraftRead,
  crossEntryOptions,
  fragmentEndpoint,
  intent,
  nuxtRoute,
  svelteKitLoad,
};
