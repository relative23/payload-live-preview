          "audit:gate": "tsx scripts/audit-gate.ts",
          "test:smoke": "tsx scripts/post-publish-smoke.ts",
          "test:coverage": "vitest run --coverage",
          "test:coverage:diff": "tsx scripts/coverage-policy.ts",
          "test:policy": "tsx scripts/test-policy.ts",
          "test:architecture": "tsx scripts/architecture-policy.ts && tsx scripts/check-complexity.ts && tsx scripts/check-trusted-core.ts && tsx scripts/compare-scope.ts --check && tsx scripts/workflow-contracts.ts && tsx scripts/docs-contracts.ts && knip --no-progress --treat-config-hints-as-errors",
          "test:property": "vitest run tests/unit/property",
          "test:mutation": "stryker run stryker.config.js",
          "test:mutation:policy:pr": "tsx scripts/mutation-policy.ts --policy quality/mutation-policy-pr.json --report test-results/stryker-pr.json",
          "test:mutation:policy:core": "tsx scripts/mutation-policy.ts --policy quality/mutation-policy-core.json --report test-results/stryker-core.json",
          "test:mutation:policy": "tsx scripts/mutation-policy.ts",
          "test:leak": "node --expose-gc --import tsx scripts/leak-soak.ts",
          "test:leak:quick": "node --expose-gc --import tsx scripts/leak-soak.ts --quick",
          "api:update": "npm run build && tsx scripts/check-package.ts --update-api-reports",
