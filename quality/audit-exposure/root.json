        "scripts": {
          "build:runtime": "node -e \"const c=require('node:child_process'),e={...process.env};if(!e.SOURCE_DATE_EPOCH){const g=c.spawnSync('git',['show','-s','--format=%ct','HEAD'],{encoding:'utf8'});if(g.status===0)e.SOURCE_DATE_EPOCH=g.stdout.trim()}process.exit(c.spawnSync(process.execPath,['--import','tsx',process.argv[1]],{stdio:'inherit',env:e}).status??1)\" scripts/build-runtime.ts",
          "build": "npm run build:runtime && tsx scripts/build-dist.ts && npm run build:assets && npm run test:bundle && npm run test:treeshake && npm run test:edge && npm run test:interaction && npm run test:protocol-semantics",
          "build:assets": "node -e \"const fs=require('node:fs');for(const f of ['RichText','PreviewBoundary'])fs.copyFileSync('src/adapters/astro/'+f+'.astro','dist/adapters/astro/'+f+'.astro')\"",
          "dev": "tsup --watch",
          "pretest": "npm run build:runtime",
          "test": "vitest run",
          "test:watch": "vitest",
          "test:security-corpus": "vitest run tests/unit/security/sanitizer-corpus.test.ts tests/unit/property/sanitizer-fuzz.property.test.ts",
          "test:unit": "vitest run tests/unit",
          "test:integration": "vitest run tests/integration",
          "test:e2e": "playwright test",
          "check:fixtures": "tsx scripts/check-fixture-freshness.ts",
          "check:generated": "tsx scripts/check-generated-runtime.ts",
          "test:e2e:real-payload": "playwright test --config playwright.real-payload.config.ts",
          "test:a11y": "playwright test tests/e2e/specs/accessibility.spec.ts",
          "test:soak": "playwright test --config playwright.soak.config.ts",
          "test:browser-bench": "playwright test --config playwright.bench.config.ts",
          "test:bench": "vitest bench tests/benchmarks",
          "test:bench:codspeed": "vitest bench --run --config vitest.bench.config.ts",
          "test:bundle": "tsx scripts/check-bundle-size.ts",
          "test:interaction": "tsx scripts/check-interaction-budgets.ts",
          "test:protocol-semantics": "tsx scripts/check-protocol-semantics.ts",
          "test:upstream-findings": "tsx scripts/check-upstream-findings.ts",
          "test:treeshake": "tsx scripts/check-tree-shaking.ts",
          "test:edge": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' tsx scripts/check-edge-runtime.ts",
          "compat:check": "tsx scripts/compat-table.ts --check",
          "compat:write": "tsx scripts/compat-table.ts --write",
          "compat:refresh": "tsx scripts/compat-table.ts --refresh",
          "diagnostics:check": "tsx scripts/diagnostic-table.ts --check",
