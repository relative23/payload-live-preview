{
  "name": "payload-live-preview",
  "version": "1.8.1",
  "description": "Live preview for Payload CMS in Astro and any SSR/static frontend (SvelteKit, Nuxt, Next.js, plain HTML). Patches the DOM live, no rebuild.",
  "author": "relative23",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./astro": {
      "import": {
        "types": "./dist/adapters/astro/index.d.ts",
        "default": "./dist/adapters/astro/index.js"
      }
    },
    "./nextjs": {
      "import": {
        "types": "./dist/adapters/nextjs/index.d.ts",
        "default": "./dist/adapters/nextjs/index.js"
      }
    },
    "./sveltekit": {
      "import": {
        "types": "./dist/adapters/sveltekit/index.d.ts",
        "default": "./dist/adapters/sveltekit/index.js"
      }
    },
    "./nuxt": {
      "import": {
        "types": "./dist/adapters/nuxt/index.d.ts",
        "default": "./dist/adapters/nuxt/index.js"
      }
    },
    "./codegen": {
      "import": {
        "types": "./dist/codegen.d.ts",
        "default": "./dist/codegen.js"
      },
      "require": {
        "types": "./dist/codegen.d.cts",
        "default": "./dist/codegen.cjs"
      }
    },
    "./codegen/astro": {
      "import": {
        "types": "./dist/codegen-astro.d.ts",
        "default": "./dist/codegen-astro.js"
      }
    },
    "./doctor": {
      "import": {
        "types": "./dist/doctor.d.ts",
        "default": "./dist/doctor.js"
      }
    },
    "./payload": {
      "import": {
        "types": "./dist/payload.d.ts",
        "default": "./dist/payload.js"
      },
      "require": {
        "types": "./dist/payload.d.cts",
        "default": "./dist/payload.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./structural": {
      "import": {
        "types": "./dist/structural.d.ts",
        "default": "./dist/structural.js"
      },
      "require": {
        "types": "./dist/structural.d.cts",
        "default": "./dist/structural.cjs"
      }
    },
    "./lexical": {
      "import": {
        "types": "./dist/lexical.d.ts",
        "default": "./dist/lexical.js"
      },
      "require": {
        "types": "./dist/lexical.d.cts",
        "default": "./dist/lexical.cjs"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins.d.ts",
        "default": "./dist/plugins.js"
      },
      "require": {
        "types": "./dist/plugins.d.cts",
        "default": "./dist/plugins.cjs"
      }
    },
    "./astro/RichText.astro": "./dist/adapters/astro/RichText.astro",
    "./astro/PreviewBoundary.astro": "./dist/adapters/astro/PreviewBoundary.astro",
    "./astro/middleware-entry": {
      "import": {
        "types": "./dist/adapters/astro/middleware-entry.d.ts",
        "default": "./dist/adapters/astro/middleware-entry.js"
      }
    }
  },
  "bin": {
    "pll-codegen": "./dist/codegen-cli.js",
    "pll": "./dist/doctor-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build:runtime": "tsx scripts/build-runtime.ts",
    "build": "npm run build:runtime && tsx scripts/build-dist.ts && npm run build:assets && npm run test:bundle && npm run test:treeshake && npm run test:edge",
    "build:assets": "node -e \"const fs=require('node:fs');for(const f of ['RichText','PreviewBoundary'])fs.copyFileSync('src/adapters/astro/'+f+'.astro','dist/adapters/astro/'+f+'.astro')\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:real-payload": "playwright test --config playwright.real-payload.config.ts",
    "test:a11y": "playwright test tests/e2e/specs/accessibility.spec.ts",
    "test:soak": "playwright test --config playwright.soak.config.ts",
    "test:browser-bench": "playwright test --config playwright.bench.config.ts",
    "test:bench": "vitest bench tests/benchmarks",
    "test:bench:codspeed": "vitest bench --run --config vitest.bench.config.ts",
    "test:bundle": "tsx scripts/check-bundle-size.ts",
    "test:treeshake": "tsx scripts/check-tree-shaking.ts",
    "test:edge": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' tsx scripts/check-edge-runtime.ts",
    "compat:check": "tsx scripts/compat-table.ts --check",
    "compat:write": "tsx scripts/compat-table.ts --write",
    "test:package": "tsx scripts/check-package.ts",
    "test:smoke": "tsx scripts/post-publish-smoke.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:diff": "tsx scripts/coverage-policy.ts",
    "test:policy": "tsx scripts/test-policy.ts",
    "test:architecture": "tsx scripts/architecture-policy.ts && tsx scripts/quality-workflow-policy.ts && knip --no-progress --treat-config-hints-as-errors",
    "test:property": "vitest run tests/unit/property",
    "test:mutation": "stryker run stryker.config.js",
    "test:mutation:policy:pr": "tsx scripts/mutation-policy.ts --policy quality/mutation-policy-pr.json --report test-results/stryker-pr.json",
    "test:mutation:policy": "tsx scripts/mutation-policy.ts",
    "test:leak": "node --expose-gc --import tsx scripts/leak-soak.ts",
    "test:leak:quick": "node --expose-gc --import tsx scripts/leak-soak.ts --quick",
    "api:update": "npm run build && tsx scripts/check-package.ts --update-api-reports",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{js,cjs,mjs,ts,json,jsonc,yml,yaml,md}\" \"quality/**/*.json\" \"docs/**/*.md\" \"type-tests/**/*.md\" \".prettierrc.json\" \".changeset/*.{json,md}\" \".github/**/*.{yml,yaml,json}\" \"examples/**/*.{ts,tsx,js,cjs,mjs,json}\" && prettier --write \"type-tests/packed/*.fixture\" --parser typescript",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{js,cjs,mjs,ts,json,jsonc,yml,yaml,md}\" \"quality/**/*.json\" \"docs/**/*.md\" \"type-tests/**/*.md\" \".prettierrc.json\" \".changeset/*.{json,md}\" \".github/**/*.{yml,yaml,json}\" \"examples/**/*.{ts,tsx,js,cjs,mjs,json}\" && prettier --check \"type-tests/packed/*.fixture\" --parser typescript",
    "check": "npm run typecheck && npm run lint && npm run test:policy && npm run test:architecture && npm run test",
    "prepublishOnly": "npm run build && npm run check && npm run format:check && npm run test:package",
    "changeset": "changeset",
    "version": "changeset version && tsx scripts/sync-lockfile-metadata.ts",
    "release": "tsx scripts/publish-artifact.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^2.31.1",
    "@codspeed/vitest-plugin": "^5.7.1",
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.4.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "terser": "^5.46.1",
    "ts-morph": "^28.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "qs": "6.15.3",
    "tsup": {
      "esbuild": "0.28.2"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": false
  },
  "keywords": [
    "astro",
    "astro-payload",
    "astro-cms",
    "astro-integration",
    "astro-live-preview",
    "payload",
    "payload-cms",
    "payload-live-preview",
    "payload-plugin",
    "live-preview",
    "preview",
    "cms",
    "headless",
    "headless-cms",
    "lexical",
    "sveltekit",
    "nuxt",
    "nextjs",
    "ssr",
    "framework-agnostic"
  ],
  "peerDependencies": {
    "astro": ">=4.0.0 <8.0.0",
    "ts-morph": "^28.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "ts-morph": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/relative23/payload-live-preview.git"
  },
  "bugs": {
    "url": "https://github.com/relative23/payload-live-preview/issues"
  },
  "homepage": "https://github.com/relative23/payload-live-preview#readme"
}
