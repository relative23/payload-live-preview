{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "projectFolder": "<lookup>",
  "mainEntryPointFilePath": "<projectFolder>/dist/index.d.ts",
  "newlineKind": "lf",
  "compiler": {
    "skipLibCheck": false
  },
  "apiReport": {
    "enabled": true,
    "reportFolder": "<projectFolder>/etc/api",
    "reportTempFolder": "<projectFolder>/temp/api",
    "includeForgottenExports": true
  },
  "docModel": {
    "enabled": false
  },
  "dtsRollup": {
    "enabled": false
  },
  "tsdocMetadata": {
    "enabled": false
  },
  "messages": {
    "extractorMessageReporting": {
      "ae-missing-release-tag": {
        "logLevel": "none"
      },
      "ae-forgotten-export": {
        "logLevel": "none",
        "addToApiReportFile": true
      },
      "ae-misplaced-package-tag": {
        "logLevel": "none"
      }
    },
    "tsdocMessageReporting": {
      "tsdoc-at-sign-without-tag-name": {
        "logLevel": "none"
      },
      "tsdoc-characters-after-block-tag": {
        "logLevel": "none"
      },
      "tsdoc-code-fence-opening-indent": {
        "logLevel": "none"
      },
      "tsdoc-escape-greater-than": {
        "logLevel": "none"
      },
      "tsdoc-escape-right-brace": {
        "logLevel": "none"
      },
      "tsdoc-html-tag-missing-greater-than": {
        "logLevel": "none"
      },
      "tsdoc-malformed-html-name": {
        "logLevel": "none"
      },
      "tsdoc-malformed-inline-tag": {
        "logLevel": "none"
      },
      "tsdoc-param-tag-missing-hyphen": {
        "logLevel": "none"
      },
      "tsdoc-undefined-tag": {
        "logLevel": "none"
      }
    }
  }
}
