{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "projectFolder": "<lookup>",
  "mainEntryPointFilePath": "<projectFolder>/dist/index.d.ts",
  "newlineKind": "lf",
  "compiler": {
    "skipLibCheck": false
  },
  "apiReport": {
    "enabled": true,
    "reportFolder": "<projectFolder>/etc/api",
    "reportTempFolder": "<projectFolder>/temp/api",
    "includeForgottenExports": true
  },
  "docModel": {
    "enabled": false
  },
  "dtsRollup": {
    "enabled": false
  },
  "tsdocMetadata": {
    "enabled": false
  },
  "messages": {
    "compilerMessageReporting": {
      // Vue 3's own declarations trip this on a generic constraint, and this
      // compiler reads them with `skipLibCheck: false` on purpose. Our sources
      // do not hide behind the suppression: `tsc --noEmit` checks them
      // separately and fails on a circular constraint of our own.
      "TS2313": {
        "logLevel": "none"
      }
    },
    "extractorMessageReporting": {
      "ae-missing-release-tag": {
        "logLevel": "none"
      },
      // `@internal` marks the names the package exports for its own tests and
      // modules and no example or guide uses (scripts/surface-usage.ts). The
      // names stay as they are: the split is a statement in the report, not a
      // rename, so a project that imported one keeps compiling.
      "ae-internal-missing-underscore": {
        "logLevel": "none",
        "addToApiReportFile": false
      },
      "ae-forgotten-export": {
        "logLevel": "none",
        "addToApiReportFile": true
      },
      "ae-misplaced-package-tag": {
        "logLevel": "none"
      }
    },
    "tsdocMessageReporting": {
      "tsdoc-at-sign-without-tag-name": {
        "logLevel": "none"
      },
      "tsdoc-characters-after-block-tag": {
        "logLevel": "none"
      },
      "tsdoc-code-fence-opening-indent": {
        "logLevel": "none"
      },
      "tsdoc-escape-greater-than": {
        "logLevel": "none"
      },
      "tsdoc-escape-right-brace": {
        "logLevel": "none"
      },
      "tsdoc-html-tag-missing-greater-than": {
        "logLevel": "none"
      },
      "tsdoc-malformed-html-name": {
        "logLevel": "none"
      },
      "tsdoc-malformed-inline-tag": {
        "logLevel": "none"
      },
      "tsdoc-param-tag-missing-hyphen": {
        "logLevel": "none"
      },
      "tsdoc-undefined-tag": {
        "logLevel": "none"
      }
    }
  }
}
