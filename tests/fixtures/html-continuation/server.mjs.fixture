/**
 * This local service serves an exact static asset allowlist and private HTML.
 * The shared lazy Node bridge carries request cancellation into the bounded
 * host reference; credentials remain in the private server configuration.
 */
import { readFileSync } from 'node:fs';
import { createServer } from 'node:http';
import { createHTMLHostReference } from '../html-host.mjs';
import { withNativeHostRequest } from '../native-request.mjs';

const config = JSON.parse(readFileSync(process.env.PLP_HTML_HOST_CONFIG, 'utf8'));
const origin = new URL(config.audience);
const handle = createHTMLHostReference({
  ...config, enabled: process.env.PLP_HTML_HOST_ENABLED === 'local-test-only', fetch,
});
const assets = new Map([
  ['/preview.js', readFileSync(new URL('./preview.js', import.meta.url))],
  ['/client.js', readFileSync(new URL('./client.js', import.meta.url))],
]);
const server = createServer((incoming, outgoing) => {
  void (async () => {
    try {
      const url = new URL(incoming.url ?? '/', origin);
      const trusted = url.origin === origin.origin && incoming.headers.host === origin.host &&
        incoming.headers['x-forwarded-proto'] === 'https';
      const asset = trusted && incoming.method === 'GET' ? assets.get(url.pathname) : undefined;
      if (asset) {
        outgoing.writeHead(200, { 'content-type': 'text/javascript; charset=utf-8', 'x-content-type-options': 'nosniff' }).end(asset);
        return;
      }
      const response = await withNativeHostRequest(incoming, url, handle);
      const headers = {};
      response.headers.forEach((value, name) => { if (name !== 'set-cookie') headers[name] = value; });
      const cookies = response.headers.getSetCookie();
      if (cookies.length) headers['set-cookie'] = cookies;
      outgoing.writeHead(response.status, headers);
      outgoing.end(Buffer.from(await response.arrayBuffer()));
    } catch {
      if (outgoing.headersSent) { outgoing.destroy(); return; }
      outgoing.writeHead(503, { 'cache-control': 'private, no-store', 'referrer-policy': 'no-referrer', vary: 'Cookie' }).end();
    }
  })();
});
server.listen(Number(process.env.PORT), '127.0.0.1');
const stop = () => { server.close(); server.closeAllConnections(); };
process.once('SIGTERM', stop);
process.once('SIGINT', stop);
