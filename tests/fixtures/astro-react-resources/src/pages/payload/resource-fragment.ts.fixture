/** Both props and Astro context derive from a currently verified page grant.
 * This fixed registry cannot select imports, assets or renderer code from fields.
 */
import type { APIRoute } from 'astro';
import reactRenderer from '@astrojs/react/server.js';
import { experimental_AstroContainer as AstroContainer } from 'astro/container';
import { createFragmentEndpoint, type FragmentRenderer } from 'payload-live-preview/astro';
import Blocks from '../../components/Blocks.astro';
import { canonical, fixture, refused } from '../../server/host';

// Only the local deployment mode chooses registration; form fields cannot.
const container = AstroContainer.create().then(instance => {
  if (process.env.PLP_ASTRO_RESOURCE_RENDERER === 'react-server') {
    instance.addServerRenderer({ renderer: reactRenderer });
  }
  return instance;
});
const render: FragmentRenderer = async (component, props, input) => {
  const active = fixture();
  const path = input.authorization.scope.path;
  const locale = input.authorization.scope.locale;
  const match = path ? /^\/continuation\/(a|b)\/(en|de)$/.exec(path) : null;
  if (!active || !path || !locale || !match || match[2] !== locale) throw new Error('Missing verified page');
  const instance = await container;
  return instance.renderToString(component as Parameters<typeof instance.renderToString>[0], {
    props,
    request: new Request(new URL(path, active.origin), { headers: { 'accept-language': locale }, signal: input.signal }),
    params: { editor: match[1], locale },
    locals: { resourcePreview: { locale, subject: input.authorization.subject ?? '' } },
  });
};
const handle = createFragmentEndpoint({
  authorizePreview: async request => {
    const active = fixture();
    const target = canonical(request);
    if (!active || !target) return null;
    const page = await active.host.page(target);
    await page.response.body?.cancel();
    return page.authorization;
  },
  registry: {
    catalog: {
      component: Blocks,
      props: input => ({
        show: input.fields.show === true,
        title: typeof input.fields.title === 'string' ? input.fields.title : '',
        delayMs: input.fields.delayMs === 80 ? 80 : 0,
      }),
    },
  },
  render,
  limits: { totalTimeoutMs: 5_000 },
});
export const ALL: APIRoute = ({ request }) => {
  const target = canonical(request);
  return target ? handle({ request: target }) : Promise.resolve(refused());
};
