/**
 * Hydrate the server's selected view without a second read or authorization cache.
 * Native departure unmounts the actual React root and its session; a persisted
 * back/forward-cache restoration must reload through current server access.
 */
import { hydrateRoot } from 'react-dom/client';
import Preview from './Preview';
import type { PreviewView } from './types';

const element = document.querySelector<HTMLElement>('#react-app');
if (!element?.dataset.previewView) throw new Error('Missing authorized preview view');
const view = JSON.parse(element.dataset.previewView) as PreviewView;
delete element.dataset.previewView;
const root = hydrateRoot(element, <Preview {...view} />);
window.addEventListener('pagehide', () => {
  root.unmount();
  element.dataset.stopped = 'true';
}, { once: true });
window.addEventListener('pageshow', event => { if (event.persisted) location.reload(); });
