/** Only the bundled server reference uses this declaration. Credentials and branded contexts never enter page load data. */
import type { AuthorizedPreviewContext } from 'payload-live-preview/server';
export function createNextHostReference(options: unknown): {
  login(request: Request): Promise<Response>;
  logout(request: Request): Promise<Response>;
  exchange(request: Request): Promise<Response>;
  load(request: Request): Promise<Response>;
  update(request: Request): Promise<Response>;
  page(request: Request): Promise<{ response: Response; authorization: AuthorizedPreviewContext | null }>;
};
