/** Request-scoped views and selected renderer locals never contain credentials. Native Astro owns their lifetime. */
import type { LivePreviewLocals } from 'payload-live-preview/astro';
import type { AuthorizedPreviewContext } from 'payload-live-preview/server';
import type { PreviewView } from './types';
declare global {
  namespace App {
    interface Locals extends LivePreviewLocals {
      previewExpectedAuthorization?: AuthorizedPreviewContext | null;
      previewView?: PreviewView;
      resourcePreview?: { locale: string; subject: string };
    }
  }
}
