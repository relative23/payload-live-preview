{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": [
      "astro/client",
      "node"
    ],
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "reference.d.mts"
  ],
  "exclude": [
    "dist",
    "type-contracts"
  ]
}
