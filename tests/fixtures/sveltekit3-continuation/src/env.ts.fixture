/** The private variables the host reads, declared as SvelteKit 3 requires. A missing one arrives as the empty string, which the host takes as switched off. */
import { defineEnvVars } from '@sveltejs/kit/env';
export const variables = defineEnvVars({
  PLP_SVELTE_HOST_ENABLED: { schema: (input) => input ?? '' },
  PLP_SVELTE_HOST_CONFIG: { schema: (input) => input ?? '' },
});
