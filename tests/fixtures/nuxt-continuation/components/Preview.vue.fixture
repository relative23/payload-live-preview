<script setup lang="ts">
/** Vue owns the hydrated tree and the packed composable's lifecycle. The envelope bridge is application test wiring, not a new public transport API. */
import { onMounted, ref } from 'vue';
import { useLivePreviewDocument } from 'payload-live-preview/vue';
import type { PreviewDocument } from '~/types/preview';
const props = defineProps<{ initialData: PreviewDocument; path: string; locale: string; origin: string }>();
const count = ref(0);
const ready = ref(false);
onMounted(() => { ready.value = true; });
let revision = 0;
const transport: typeof fetch = async (input, init) => {
  const expected = ++revision;
  const { data, locale } = JSON.parse(String(init?.body));
  const endpoint = new URL(input instanceof Request ? input.url : String(input));
  if (endpoint.pathname !== `/api/articles/${props.initialData.id}` || String(data.id) !== String(props.initialData.id) || locale !== props.locale) throw new Error('Reference identity mismatch');
  const response = await fetch(`${props.path}/data?preview=true&locale=${props.locale}`, {
    method: 'POST', headers: { 'content-type': 'application/json' }, credentials: 'same-origin', signal: init?.signal,
    body: JSON.stringify({ version: 1, revision: expected, data: { title: data.title, related: data.related, files: data.files } }),
  });
  if (!response.ok) { await response.body?.cancel(); return new Response(null, { status: response.status }); }
  const envelope = await response.json();
  if (envelope.version !== 1 || envelope.ok !== true || envelope.revision !== expected) throw new Error('Reference revision mismatch');
  return Response.json(envelope.data);
};
const { data, status, isLoading } = useLivePreviewDocument({ initialData: props.initialData,
  serverURL: props.origin, allowedOrigins: [props.origin], fetchFn: transport, depth: 2,
  eventSourcePolicy: 'parent-or-opener', enableReferrerDetection: false, enableLocalhostMatching: false,
});
function labels(values: unknown[] | undefined) {
  return (values ?? []).map(value => typeof value === 'object' && value !== null && 'title' in value ? String(value.title) : `ID:${String(value)}`).join(' | ');
}
</script>
<template>
  <main data-payload-island>
    <h1 data-testid="title">{{ data.title }}</h1>
    <p data-testid="related">{{ labels(data.related) }}</p><p data-testid="files">{{ labels(data.files) }}</p>
    <output data-testid="ready">{{ ready ? 'ready' : 'hydrating' }}</output>
    <output data-testid="status">{{ status === 'idle' ? 'idle' : isLoading ? 'loading' : status }}</output>
    <button data-testid="counter" @click="count++">{{ count }}</button><input data-testid="visitor" value="Visitor state" />
    <NuxtLink :prefetch="false" :to="`${path}?locale=${locale}&preview=true`" data-testid="valid-navigation">Authorized navigation</NuxtLink>
    <NuxtLink :prefetch="false" :to="`${path}?preview=true&locale=${locale}&invalid=1`" data-testid="denied-navigation">Denied navigation</NuxtLink>
    <NuxtLink :prefetch="false" :to="`/?from=${locale}`" data-testid="navigation">Public shell</NuxtLink>
  </main>
</template>
